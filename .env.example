# Safe example configuration - no secrets are needed anywhere in this project.
# Copy to .env.local if you want to override the defaults.

# Base path used for production builds (GitHub Pages sub-path).
# Use the form /<repository-name>/ . Use ./ for fully relative paths.
VITE_BASE_PATH=/veridocs/

# Optional: repository URL used by the GitHub button in the header.
VITE_REPO_URL=https://github.com/USERNAME/veridocs
